{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benweru.github.io/morning-briefing/data/run.schema.json",
  "title": "Ben's Morning Briefing run",
  "description": "One morning run, stored as data/runs/YYYY-MM-DD.json. Fields marked derived are (re)computed by build/publish_run.py.",
  "type": "object",
  "required": [
    "schema_version",
    "run_date",
    "checked_at",
    "sources",
    "counts",
    "method",
    "jobs",
    "dropped",
    "news"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Must match the file name."
    },
    "checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When postings were checked, ISO 8601 with offset, in EAT, e.g. 2026-10-08T07:30:00+03:00."
    },
    "sources": {
      "type": "object",
      "required": [
        "jobs",
        "news"
      ],
      "properties": {
        "jobs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Job sources checked, as display phrases, e.g. 'Remotive API (returned only 17 jobs)'."
        },
        "news": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "News publishers used."
        }
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "pulled"
      ],
      "properties": {
        "pulled": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Postings pulled from all sources before filtering."
        },
        "pulled_is_approximate": {
          "type": "boolean"
        },
        "filtered_out": {
          "type": "object",
          "description": "Bulk filter counts (null when not counted).",
          "properties": {
            "older_than_30_days": {
              "type": [
                "integer",
                "null"
              ]
            },
            "senior_title": {
              "type": [
                "integer",
                "null"
              ]
            },
            "not_target_role": {
              "type": [
                "integer",
                "null"
              ]
            },
            "location_or_timezone": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "filtered_out_is_approximate": {
          "type": "boolean"
        },
        "reviewed_closely": {
          "type": "integer",
          "description": "derived: shortlisted + dropped"
        },
        "shortlisted": {
          "type": "integer",
          "description": "derived"
        },
        "dropped": {
          "type": "integer",
          "description": "derived"
        },
        "dropped_by_reason": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "description": "derived from dropped[].reason_code"
        },
        "stories": {
          "type": "integer",
          "description": "derived"
        }
      }
    },
    "method": {
      "type": "object",
      "required": [
        "filtering_summary"
      ],
      "properties": {
        "filtering_summary": {
          "type": "string",
          "description": "One or two sentences shown in the footer: what was pulled and why most were filtered out."
        }
      }
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "description": "Shortlist, 6-10 roles.",
      "items": {
        "type": "object",
        "required": [
          "rank",
          "tier",
          "url",
          "title",
          "company",
          "location_as_stated",
          "posted",
          "salary_as_shown",
          "experience_asked",
          "found_via",
          "verified",
          "fit",
          "gaps"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "description": "1..N, no gaps."
          },
          "tier": {
            "enum": [
              "top",
              "evergreen",
              "stretch"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^https?://",
            "description": "Posting URL exactly as verified (employer careers page or ATS board preferred)."
          },
          "id": {
            "type": "string",
            "pattern": "^j-[0-9a-f]{12}$",
            "description": "Derived by publish_run.py: 'j-' + sha1(normalised url)[:12]. Do not write by hand."
          },
          "title": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "location_as_stated": {
            "type": "string",
            "description": "Eligibility text quoted from the posting."
          },
          "posted": {
            "type": "string",
            "description": "Date shown by the source (YYYY-MM-DD), or relisting note."
          },
          "salary_as_shown": {
            "type": "string",
            "description": "As shown, or 'Not shown'."
          },
          "experience_asked": {
            "type": "string",
            "description": "As the posting states it."
          },
          "found_via": {
            "type": "string",
            "description": "Where the lead came from."
          },
          "verified": {
            "type": "string",
            "description": "Where and when it was confirmed live, e.g. 'Greenhouse API, live 2026-10-08'."
          },
          "note": {
            "type": "string",
            "description": "Optional free-text research note (not rendered)."
          },
          "fit": {
            "type": "string",
            "description": "Why it matches Ben's CV (one or two sentences)."
          },
          "gaps": {
            "type": "string",
            "description": "What's missing or risky (one or two sentences)."
          }
        }
      }
    },
    "dropped": {
      "type": "array",
      "description": "Roles reviewed closely and rejected.",
      "items": {
        "type": "object",
        "required": [
          "url",
          "title",
          "company",
          "location_as_stated",
          "reason",
          "reason_code"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https?://",
            "description": "Posting URL exactly as verified (employer careers page or ATS board preferred)."
          },
          "id": {
            "type": "string",
            "pattern": "^j-[0-9a-f]{12}$",
            "description": "Derived by publish_run.py: 'j-' + sha1(normalised url)[:12]. Do not write by hand."
          },
          "title": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "location_as_stated": {
            "type": "string",
            "description": "Eligibility text quoted from the posting."
          },
          "posted": {
            "type": "string",
            "description": "Date shown by the source (YYYY-MM-DD), or relisting note."
          },
          "salary_as_shown": {
            "type": "string",
            "description": "As shown, or 'Not shown'."
          },
          "experience_asked": {
            "type": "string",
            "description": "As the posting states it."
          },
          "found_via": {
            "type": "string",
            "description": "Where the lead came from."
          },
          "verified": {
            "type": "string",
            "description": "Where and when it was confirmed live, e.g. 'Greenhouse API, live 2026-10-08'."
          },
          "note": {
            "type": "string",
            "description": "Optional free-text research note (not rendered)."
          },
          "reason": {
            "type": "string",
            "description": "Specific reason, shown in the appendix."
          },
          "reason_code": {
            "enum": [
              "location",
              "experience",
              "stale",
              "closed",
              "stack",
              "requirement",
              "other"
            ]
          }
        }
      }
    },
    "news": {
      "type": "object",
      "required": [
        "groups"
      ],
      "properties": {
        "groups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "id",
              "stories"
            ],
            "properties": {
              "id": {
                "enum": [
                  "ai",
                  "startups",
                  "hiring",
                  "kenya"
                ]
              },
              "name": {
                "type": "string",
                "description": "derived from id"
              },
              "stories": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "title",
                    "summary",
                    "why",
                    "source",
                    "date",
                    "url"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "derived: 's-' + sha1(normalised url)[:12]"
                    },
                    "title": {
                      "type": "string"
                    },
                    "summary": {
                      "type": "string",
                      "description": "One line, factual."
                    },
                    "why": {
                      "type": "string",
                      "description": "Why it matters for Ben, one line."
                    },
                    "source": {
                      "type": "string",
                      "description": "Publisher, e.g. 'TechCabal'."
                    },
                    "date": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                      "description": "Publication date."
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^https?://"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "local_jobs": {
      "type": "object",
      "description": "derived: Kenya jobs snapshot taken by build/publish_run.py from /workspace/shared/local-jobs/latest.json when the run is dated today (EAT). status ok = the file was dated today; not_run = missing, unreadable, stale or example data. Absent on runs from before the section existed.",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "not_run"
          ]
        },
        "reason": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        },
        "sources_checked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "example": {
          "type": "boolean"
        },
        "jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "company": {
                "type": "string"
              },
              "location": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "posted": {
                "type": "string"
              },
              "fit_note": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
